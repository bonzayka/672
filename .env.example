# Скопируйте этот файл под именем .env и заполните.

# Токен бота от @BotFather.
# ВНИМАНИЕ: старый токен из репозитория утёк — сначала /revoke в @BotFather!
BOT_TOKEN=

# ID админов через запятую (узнать свой ID: отправьте боту /id)
ADMIN_IDS=

# file_id стикера для /start (необязательно).
# Как получить: переслать боту стикер с админ-аккаунта — бот ответит file_id.
STICKER_FILE_ID=
